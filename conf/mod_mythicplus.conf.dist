########################################
# MYTHIC PLUS
########################################
#
# Keyed dungeon runs for five level 80 players.
# The first season matches the builder's 45 maps and nine themes.
#

MythicPlus.Enable = 1
MythicPlus.Debug = 0
MythicPlus.NpcEntry = 500100

# Key floor, death penalty, and the default timer.
MythicPlus.KeyFloor = 2
MythicPlus.DeathPenaltySeconds = 5
MythicPlus.TimerSeconds = 1800

# Remaining-time bands. A finish inside the timer rises by 1, 2, or 3.
MythicPlus.UpgradePercent.3 = 40
MythicPlus.UpgradePercent.2 = 20

# Enemy share of creatures this mode spawned. Zero spawned is a miss.
MythicPlus.EnemyForcePercent = 80

# Health and damage: 1.10 + 0.10 * (key level - 2), on heroic when the map has it.
MythicPlus.Scaling.BaseMultiplier = 1.10
MythicPlus.Scaling.PerKeyMultiplier = 0.10

# Gear: 245 at key 2, plus 3 item levels for each key level above 2.
MythicPlus.Gear.BaseItemLevel = 245
MythicPlus.Gear.ItemLevelPerKey = 3

# Score weight per best timed key level.
MythicPlus.Score.PerKey = 10

# Weekly reset. Weekday uses 0 = Sunday through 6 = Saturday. 3 = Wednesday.
MythicPlus.ResetWeekday = 3
MythicPlus.ResetHour = 8

# First-season modifier bands. A later season may move these five.
# A name the module does not implement is ignored.
MythicPlus.Modifier.Fortified = 2
MythicPlus.Modifier.Tyrannical = 4
MythicPlus.Modifier.Raging = 7
MythicPlus.Modifier.Bolstering = 10
MythicPlus.Modifier.Savage = 12

# Themes: "Name,creature type". -1 is the random mix.
MythicPlus.Theme.1 = "Beast Hunt,1"
MythicPlus.Theme.2 = "Dragon's Lair,2"
MythicPlus.Theme.3 = "Demonic Invasion,3"
MythicPlus.Theme.4 = "Elemental Chaos,4"
MythicPlus.Theme.5 = "Giant's Keep,5"
MythicPlus.Theme.6 = "Undead Rising,6"
MythicPlus.Theme.7 = "Humanoid Stronghold,7"
MythicPlus.Theme.8 = "Mechanical Mayhem,9"
MythicPlus.Theme.9 = "Random Chaos,-1"

# Dungeons: "mapId,Name". The first season is the builder's source list.
MythicPlus.Dungeon.1 = "389,Ragefire Chasm"
MythicPlus.Dungeon.2 = "36,Deadmines"
